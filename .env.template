# ── LLM providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Default model (used by examples / CLI) ───────────────────────────────────
MODEL=anthropic:claude-sonnet-4-6

# ── Azure OpenAI embedder ─────────────────────────────────────────────────────
# Required when EMBEDDING_MODEL starts with "azure:"
EMBEDDING_BINDING_HOST=https://<your-resource>.openai.azure.com
EMBEDDING_BINDING_API_KEY=

# ── Corpus RAG models ─────────────────────────────────────────────────────────
EMBEDDING_MODEL=azure:text-embedding-3-small
EXPANSION_MODEL=anthropic:claude-haiku-4-5-20251001
ANSWER_MODEL=anthropic:claude-sonnet-4-6
RERANK_MODEL=anthropic:claude-haiku-4-5-20251001

# ── Corpus storage ────────────────────────────────────────────────────────────
# Absolute path where corpora are stored on disk.
# Default (/tmp/firefly/corpora) is ephemeral — override for any persistent deployment.
# On Azure Container Apps mount an Azure Files share and set this to /mnt/corpora.
CORPUS_ROOT=/tmp/firefly/corpora

# ── MCP HTTP server ───────────────────────────────────────────────────────────
PORT=8080

# ── Azure Monitor (optional) ──────────────────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
