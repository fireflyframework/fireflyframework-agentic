# ── LLM providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Default model (used by examples / CLI) ───────────────────────────────────
MODEL=anthropic:claude-sonnet-4-6

# ── Model tiers (used by examples/delegation_strategies.py) ──────────────────
# CostAwareStrategy needs distinct prices to produce a meaningful ranking,
# so the delegation example reads three tiers instead of MODEL.
MODEL_CHEAP=anthropic:claude-haiku-4-5
MODEL_MED=anthropic:claude-sonnet-4-6
MODEL_EXPENSIVE=anthropic:claude-opus-4-7

# ── Embeddings (optional; used by the embed / search examples) ───────────────
# EMBEDDING_MODEL selects "provider:model". Each provider adapter reads its
# own credentials from the environment (e.g. OPENAI_API_KEY for openai:*).
EMBEDDING_MODEL=openai:text-embedding-3-small

# ── Observability (optional, vendor-neutral) ─────────────────────────────────
# Point at any OTLP collector (Jaeger, Tempo, ADOT, OpenTelemetry Collector).
# Leave unset to log telemetry to the console.
# OTLP_ENDPOINT=http://localhost:4317
