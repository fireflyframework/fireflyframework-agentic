# ── LLM providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Default model (used by examples / CLI) ───────────────────────────────────
MODEL=anthropic:claude-sonnet-4-6

# ── Model tiers (used by examples/delegation_strategies.py) ──────────────────
# CostAwareStrategy needs distinct prices to produce a meaningful ranking,
# so the delegation example reads three tiers instead of MODEL.
MODEL_CHEAP=anthropic:claude-haiku-4-5
MODEL_MED=anthropic:claude-sonnet-4-6
MODEL_EXPENSIVE=anthropic:claude-opus-4-7

# ── Azure OpenAI embedder ─────────────────────────────────────────────────────
# Required when EMBEDDING_MODEL starts with "azure:"
EMBEDDING_BINDING_HOST=https://<your-resource>.openai.azure.com
EMBEDDING_BINDING_API_KEY=

# ── Corpus RAG models ─────────────────────────────────────────────────────────
EMBEDDING_MODEL=azure:text-embedding-3-small
EXPANSION_MODEL=anthropic:claude-haiku-4-5-20251001
ANSWER_MODEL=anthropic:claude-sonnet-4-6
RERANK_MODEL=anthropic:claude-haiku-4-5-20251001

# ── Corpus storage ────────────────────────────────────────────────────────────
# Absolute path where corpora are stored on disk.
# Default (/tmp/firefly/corpora) is ephemeral — override for any persistent deployment.
# On Azure Container Apps mount an Azure Files share and set this to /mnt/corpora.
CORPUS_ROOT=/tmp/firefly/corpora

# ── DB storage backend (corpus_search example) ────────────────────────────────
# Selects how the SQLite corpus file is stored. "local" keeps it on disk under
# CORPUS_ROOT (default). "azure" stores it in Azure Blob Storage via the new
# DatabaseStore + AzureBlobBackend, with blob-lease serialisation and a local
# write-through cache.
CORPUS_SEARCH_BACKEND=local

# Required when CORPUS_SEARCH_BACKEND=azure. The container URL used by
# AzureBlobBackend; auth uses DefaultAzureCredential (managed identity / az
# login / env). Install the storage-azure extra: uv sync --extra storage-azure.
CORPUS_SEARCH_AZURE_CONTAINER_URL=https://<account>.blob.core.windows.net/<container>
# Optional override for the blob name within the container.
CORPUS_SEARCH_AZURE_BLOB_NAME=corpus.sqlite

# Optional: where DatabaseStore caches downloaded SQLite files locally
# (defaults to ~/.cache/fireflyframework_agentic/dbstore).
# FIREFLY_DBSTORE_CACHE_ROOT=/var/cache/fireflyframework_agentic/dbstore

# ── Azurite (local Azure Storage emulator — tests only) ───────────────────────
# Set to the Azurite dev connection string to enable the nightly Azurite tests
# in tests/integration/storage/ and the parameterised E2E variants in
# tests/examples/corpus_search/. Run Azurite with:
#   docker run -p 10000:10000 mcr.microsoft.com/azure-storage/azurite
# AZURITE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# ── MCP HTTP server ───────────────────────────────────────────────────────────
PORT=8080

# ── Azure Monitor (optional) ──────────────────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
